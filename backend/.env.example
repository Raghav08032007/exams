# Copy this file to .env and fill in your values
FLASK_APP=run.py
FLASK_ENV=development

# Secret keys — change these in production!
SECRET_KEY=change-me-in-production-super-secret-key
JWT_SECRET_KEY=change-me-jwt-secret-key

# Database — choose one:
# SQLite (local dev, no setup needed):
DATABASE_URL=sqlite:///examvault.db
# MySQL (production):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/examvault

# File uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# Admin seeding
ADMIN_EMAIL=admin@examvault.in
ADMIN_PASSWORD=Admin@1234
